# ==========================================
# LunchMate Backend - Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit your real .env file to Git!
# ==========================================

PORT=5000
NODE_ENV=development

# Database (PostgreSQL / Prisma)
DATABASE_URL="postgresql://postgres:lunchmate123@localhost:5432/lunchmate?schema=public"

# Redis Cache / Session Store
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET="your_jwt_secret_key_here_min_32_chars"

# Payment Gateway - YouPI Pay-In (Zero fee UPI QR & UTR Verification)
YOUPI_MERCHANT_VPA="lunchmate.escrow@icici"

# Payment Gateway - RazorpayX Driver Payouts (Triggered on School Gate OTP)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder_secret_key"
